      "id": "C2-LIT",
      "decision": "Do not import psycopg2; the service uses SQLite.",
      "rationale": "Single-file deployment.",
      "scope": [
        "database",
        "storage"
      ],
      "constraints": [
        "Use sqlite3 only"
      ],
      "anti_patterns": [
        "psycopg2"
      ],
      "status": "active",
      "rules": [
        {
          "type": "FORBID_LITERAL",
          "value": "psycopg2"
        }
      ],
      "test_evidence": [
        {
          "selector": "tests/test_storage.py::test_sqlite_only"
        }
      ]
    },
    {
