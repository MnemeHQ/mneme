# Pins for the H1c Amendment A1 runs (probe scope 4.2). Everything is as in pins.env
# (Claude Code 2.1.202, init model, PY via pins.local.env, sources project) EXCEPT the
# disposable root, which is separate so the H1 batch evidence and its archive are
# never touched.
# A1 keeps the H1 pins; a pin set selected for another batch must never leak in.
[ -z "${H1_PINSET+set}" ] || { echo "ABORT: H1_PINSET='$H1_PINSET' is set (even empty counts); A1 runs use the H1 pins only"; exit 1; }
_A1_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$_A1_DIR/pins.env"
LIVE='/c/dev/d5p2-h1c-a1-live'   # fixed; must match ROOT in safe_rmtree_a1.py (no override)
A1_LIVE_W='C:\dev\d5p2-h1c-a1-live'
A1_RMTREE='safe_rmtree_a1.py'

# Amendment A3 pin set (probe scope 4.4): the A1 track (H1c, Stop top-level
# systemMessage) re-pinned to the host and model of Amendment A2, so all four H1
# paths can share one pin. Selected only with A1_PINSET=A3, which the entry points
# set from their first argument (run_a1_headless.sh A3, prep_a1_interactive.sh A3
# <arm>, finish_a1_interactive.sh A3 <arm> <recording>). It has its own disposable
# root and guarded delete. --model makes the init model deterministic, and
# DISABLE_AUTOUPDATER=1 is required (preflight and every probe check it).
# A1_PINSET is in pins.env's snapshot, so pins.local.env cannot select it.
A3_PIN_CLAUDE_VERSION='2.1.310 (Claude Code)'
A3_PIN_MODEL='claude-opus-5-5'
if [ "${A1_PINSET:-}" = A3 ]; then
  PIN_CLAUDE_VERSION=$A3_PIN_CLAUDE_VERSION
  PIN_MODEL=$A3_PIN_MODEL
  PIN_MODEL_FLAG=$A3_PIN_MODEL
  LIVE='/c/dev/d5p2-h1c-a3-live'   # fixed; must match ROOT in safe_rmtree_a3.py (no override)
  A1_LIVE_W='C:\dev\d5p2-h1c-a3-live'
  A1_RMTREE='safe_rmtree_a3.py'
elif [ -n "${A1_PINSET+set}" ]; then   # any other value, including set-but-empty
  echo "ABORT: unknown A1_PINSET '${A1_PINSET}' (only A3 is defined; leave it unset for the A1 pins)"; exit 1
fi
