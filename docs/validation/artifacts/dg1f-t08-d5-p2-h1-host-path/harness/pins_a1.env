# Pins for the H1c Amendment A1 runs (probe scope 4.2). Everything is as in pins.env
# (Claude Code 2.1.202, init model, PY via pins.local.env, sources project) EXCEPT the
# disposable root, which is separate so the H1 batch evidence and its archive are
# never touched.
# A1 keeps the H1 pins; a pin set selected for another batch must never leak in.
[ -z "${H1_PINSET+set}" ] || { echo "ABORT: H1_PINSET='$H1_PINSET' is set (even empty counts); A1 runs use the H1 pins only"; exit 1; }
_A1_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$_A1_DIR/pins.env"
LIVE='/c/dev/d5p2-h1c-a1-live'   # fixed; must match ROOT in safe_rmtree_a1.py (no override)
