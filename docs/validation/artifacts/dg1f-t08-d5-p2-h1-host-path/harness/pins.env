# Pinned configuration for the H1 (Claude Code) host-output-path channel probes,
# per the accepted probe scope docs/plans/2026-10-17-dg1f-t08-d5-p2-host-path-probe-scope.md
# (#545, sections 3, 3.1 and 7). Sourced by every runner. Operator-specific paths are
# placeholders here and are filled in by the untracked pins.local.env next to this
# file (gitignored). The preflight fails if any placeholder is left.
PIN_CLAUDE_VERSION='2.1.202 (Claude Code)'
PIN_MODEL='claude-opus-4-8[1m]'          # init-event model observed in the C1-C4 batches
# Python used by the emitter and the classifier (no spaces in path).
PY='<PYTHON: absolute path to python.exe, no spaces>'
# Disposable probe workspaces live OUTSIDE any git checkout and any .mneme ancestor.
LIVE='/c/dev/d5p2-h1-live'   # fixed; must match ROOT in safe_rmtree.py (no override)
# Settings sources for every probe: project only. No user, local or managed source.
SOURCES='project'
# H1 pin set (the as-run H1 batch): every path, no --model flag, guarded delete
# safe_rmtree.py.
LIVE_W_EXPECTED='C:\dev\d5p2-h1-live'
RMTREE='safe_rmtree.py'
H1_PATHS='H1a-edit H1a-bash H1b-start H1c-stop'
PIN_MODEL_FLAG=''

# Amendment A2 pin set (probe scope 4.3): H1a and H1b re-pinned to the host G3 ran on.
# Selected only with H1_PINSET=A2 (run_h1.sh A2 sets it). Stop (H1c) is not in it.
# It has its own disposable root and guarded delete, so the H1 batch evidence,
# the A1 evidence and their archives are never touched. --model makes the init
# model deterministic (the account default drifted during the A1 attempts), and
# DISABLE_AUTOUPDATER=1 is required (preflight and every probe check it).
A2_PIN_CLAUDE_VERSION='2.1.310 (Claude Code)'
A2_PIN_MODEL='claude-opus-5-5'
if [ "${H1_PINSET:-}" = A2 ]; then
  PIN_CLAUDE_VERSION=$A2_PIN_CLAUDE_VERSION
  PIN_MODEL=$A2_PIN_MODEL
  PIN_MODEL_FLAG=$A2_PIN_MODEL
  LIVE='/c/dev/d5p2-h1-a2-live'   # fixed; must match ROOT in safe_rmtree_a2.py (no override)
  LIVE_W_EXPECTED='C:\dev\d5p2-h1-a2-live'
  RMTREE='safe_rmtree_a2.py'
  H1_PATHS='H1a-edit H1a-bash H1b-start'
elif [ -n "${H1_PINSET+set}" ]; then   # any other value, including set-but-empty
  echo "ABORT: unknown H1_PINSET '${H1_PINSET}' (only A2 is defined; leave it unset for the H1 pins)"; exit 1
fi

# The untracked pins.local.env supplies operator paths (PY) only. It must not
# change any pinned value: those are snapshotted here and compared after it is
# sourced, and any change aborts (review of #794). The preflight also records
# the file's SHA-256.
_PIN_VARS='SOURCES PIN_CLAUDE_VERSION PIN_MODEL PIN_MODEL_FLAG LIVE LIVE_W_EXPECTED RMTREE H1_PATHS
A2_PIN_CLAUDE_VERSION A2_PIN_MODEL H1_PINSET A1_PINSET'
_pin_snapshot() { local v; for v in $_PIN_VARS; do printf '%s=%s\n' "$v" "${!v-<unset>}"; done; }
_PIN_BEFORE=$(_pin_snapshot)
_PINS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$_PINS_DIR/pins.local.env" ] && . "$_PINS_DIR/pins.local.env"
if [ "$(_pin_snapshot)" != "$_PIN_BEFORE" ]; then
  _pin_changed=''
  for _v in $_PIN_VARS; do
    printf '%s\n' "$_PIN_BEFORE" | grep -qxF -- "$_v=${!_v-<unset>}" || _pin_changed="$_pin_changed $_v"
  done
  echo "ABORT: pins.local.env changed pinned value(s):$_pin_changed. It may set operator paths (PY) only."
  exit 1
fi
