# Pinned configuration for the H1 (Claude Code) host-output-path channel probes,
# per the accepted probe scope docs/plans/2026-10-17-dg1f-t08-d5-p2-host-path-probe-scope.md
# (#545, sections 3, 3.1 and 7). Sourced by every runner. Operator-specific paths are
# placeholders here and are filled in by the untracked pins.local.env next to this
# file (gitignored). The preflight fails if any placeholder is left.
PIN_CLAUDE_VERSION='2.1.202 (Claude Code)'
PIN_MODEL='claude-opus-4-8[1m]'          # init-event model observed in the C1-C4 batches
# Python used by the emitter and the classifier (no spaces in path).
PY='<PYTHON: absolute path to python.exe, no spaces>'
# Disposable probe workspaces live OUTSIDE any git checkout and any .mneme ancestor.
LIVE='/c/dev/d5p2-h1-live'   # fixed; must match ROOT in safe_rmtree.py (no override)
# Settings sources for every probe: project only. No user, local or managed source.
SOURCES='project'

_PINS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$_PINS_DIR/pins.local.env" ] && . "$_PINS_DIR/pins.local.env"
