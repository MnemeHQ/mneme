# Pinned configuration for the ADR-033 C3 live validation (scope #592).
# Sourced by every runner. Operator-specific paths are placeholders here and
# are filled in by the untracked pins.local.env next to this file (gitignored).
# The preflight fails if any placeholder is left, and records the
# pins.local.env hash.
PIN_CLAUDE_VERSION='2.1.303 (Claude Code)'
PIN_MODEL='claude-opus-5-5'                # passed as --model; init event must match
PIN_MNEME_BASE='b0dc1a146e37e27ee3d4c32a4e098668ee2c8271'  # #613 (ADR-034 F-1), after F-R2 #608; mneme/ must equal this tree
FIXTURE_URL='https://github.com/MnemeHQ/mneme-claude-code-enforcement-fixture'
# Mneme source the hook imports: a clean checkout whose mneme/ equals PIN_MNEME_BASE.
MNEME_SRC_W='<MNEME_SRC windows path>'
MNEME_SRC_U='<MNEME_SRC posix path>'
# Python used by the hook command, setup and classifier (no spaces in path).
PY='<PYTHON: absolute path to python.exe, no spaces>'
# Disposable probe repositories live OUTSIDE any git checkout and any .mneme
# ancestor. Fixed; must match LIVE_ROOT in safe_rmtree.py (no override).
LIVE='/c/dev/mneme-c3-live'
# Settings sources for every probe (scope §4).
SOURCES='project'

# T-08 G3 pin set (charter docs/plans/2026-11-10-t08-g3-host-boundary-live-charter.md
# §5). Selected only with C3_PINSET=G3 (run_c3_batch.sh G3 sets it); every
# other row keeps the C3 pins above. The host version is the one installed for
# the G3 run, with DISABLE_AUTOUPDATER=1 (charter O2): results hold for it only.
G3_PIN_CLAUDE_VERSION='2.1.310 (Claude Code)'
G3_PIN_MNEME_BASE='1575008772128c53c38e7a16b960c05cd5546bdd'  # main @ 15750087 (#790), the charter anchor
G3_FIXTURE_TIP='5125231076fb5a8e537a483c84850de99c25ba57'     # fixture main, phase AUTHORIZED
if [ "${C3_PINSET:-}" = G3 ]; then
  PIN_CLAUDE_VERSION=$G3_PIN_CLAUDE_VERSION
  PIN_MNEME_BASE=$G3_PIN_MNEME_BASE
elif [ -n "${C3_PINSET:-}" ]; then
  echo "ABORT: unknown C3_PINSET '${C3_PINSET}'"; exit 1
fi

_PINS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$_PINS_DIR/pins.local.env" ] && . "$_PINS_DIR/pins.local.env"
# Self-test only (selftest/run_selftest.sh): paths come from C3_ST_* instead.
if [ "${C3_SELFTEST:-}" = 1 ]; then
  MNEME_SRC_W="$C3_ST_MNEME_SRC"; MNEME_SRC_U=$(cygpath -u "$C3_ST_MNEME_SRC"); PY="$C3_ST_PY"
  # The self-test remote has its own tip; its G3 guard is exercised against it.
  [ -n "${C3_ST_G3_FIXTURE_TIP:-}" ] && G3_FIXTURE_TIP="$C3_ST_G3_FIXTURE_TIP"
fi
