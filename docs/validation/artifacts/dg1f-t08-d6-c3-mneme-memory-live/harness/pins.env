# Pinned configuration for D6 batch 3 (C3), sourced by every runner.
# Identical pins to batch 2 (#521). Operator-specific paths are placeholders
# here and are filled in by the untracked pins.local.env next to this file
# (gitignored). The preflight fails if any placeholder is left. The as-run
# pins.local.env hash is recorded at run time.
PIN_CLAUDE_VERSION='2.1.202 (Claude Code)'
PIN_MODEL='claude-opus-4-8[1m]'          # init-event model observed in #518, #520 and #521
PIN_MNEME_BASE='40ab0dd12c3f02b960d66c6fd08ab146ac5d369e'  # mneme/ must equal this tree
PIN_MNEME_VERSION='0.10.0'
# Mneme source the hook imports: this task worktree (mneme/ identical to PIN_MNEME_BASE).
MNEME_SRC_W='<MNEME_SRC windows path>'
MNEME_SRC_U='<MNEME_SRC posix path>'
# Python used by the hook command and the post-hoc checker (no spaces in path).
PY='<PYTHON: absolute path to python.exe, no spaces>'
# Disposable probe repos live OUTSIDE any git checkout and any .mneme ancestor.
LIVE='/c/dev/t08-d6-live'   # fixed; must match ROOT in safe_rmtree.py (no override)
# Settings sources for every probe in this batch (#519 §4: C3 uses project,local).
SOURCES='project,local'

_PINS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$_PINS_DIR/pins.local.env" ] && . "$_PINS_DIR/pins.local.env"
