# Batch-2 pins (probe scope section 7). A mismatch aborts; a re-pin needs a
# reviewed amendment. Credential VALUES never go here or in any file: the
# operator supplies them in the launching shell's environment only.
ANTIGRAVITY_VERSION=2.8.1
HERMES_AGENT_VERSION=0.19.0
# Upstream source of hermes-agent 0.19.0 (pyproject version at this tag),
# used for the interface verification recorded in README.md.
HERMES_AGENT_SOURCE_TAG=v2026.7.20
LIVE_ROOT_W=C:\dev\d5p2-batch2-live
# Names (never values) of the provider-credential variables the Hermes live
# session reads; the leak scan checks every evidence file for their values.
HERMES_CREDENTIAL_VARS=OPENROUTER_API_KEY,ANTHROPIC_API_KEY,OPENAI_API_KEY,NOUS_API_KEY
