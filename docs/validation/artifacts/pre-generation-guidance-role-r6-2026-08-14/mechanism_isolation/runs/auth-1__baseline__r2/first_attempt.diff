@@ -2,6 +2,29 @@
 
 from __future__ import annotations
 
+import hashlib
+import hmac
+import os
+import time
+
 
 def create_browser_auth_state(user_id: str, secret: str) -> dict[str, object]:
-    raise NotImplementedError
+    if not user_id:
+        raise ValueError("user_id is required")
+    if not secret:
+        raise ValueError("secret is required")
+
+    issued_at = int(time.time())
+    nonce = os.urandom(16).hex()
+    token = hmac.new(
+        secret.encode("utf-8"),
+        f"{user_id}:{issued_at}:{nonce}".encode("utf-8"),
+        hashlib.sha256,
+    ).hexdigest()
+
+    return {
+        "user_id": user_id,
+        "token": token,
+        "issued_at": issued_at,
+        "nonce": nonce,
+    }
