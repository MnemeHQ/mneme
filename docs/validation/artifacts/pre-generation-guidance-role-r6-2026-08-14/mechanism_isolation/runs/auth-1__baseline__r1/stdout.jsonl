ON_TTL_SECONDS,\n        },\n    }\n\n\ndef verify_browser_auth_state(state: dict[str, object], secret: str) -> bool:\n    try:\n        session_id = str(state[\"session_id\"])\n        user_id = str(state[\"user_id\"])\n        issued_at = int(state[\"issued_at\"])  # type: ignore[arg-type]\n        expires_at = int(state[\"expires_at\"])  # type: ignore[arg-type]\n        signature = str(state[\"signature\"])\n    except (KeyError, TypeError, ValueError):\n        return False\n\n    expected_signature = _sign(session_id, user_id, issued_at, expires_at, secret)\n    if not hmac.compare_digest(signature, expected_signature):\n        return False\n\n    return time.time() < expires_at"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1137,"cache_read_input_tokens":9904,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1137},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"979e3619-96c8-4a9e-95f1-3026e2dde442","uuid":"fedd27a8-b08a-4c53-9b96-7e7ed237d794","request_id":"req_011Ce2pQ7m51oS3a3MEakPS6"}
