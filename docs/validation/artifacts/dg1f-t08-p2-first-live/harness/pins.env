# Pinned configuration for the T-08 P2-first live evidence batch (charter
# §5.2.7 step 5), sourced by every runner. Operator-specific paths are
# placeholders here and are filled in by the untracked pins.local.env next to
# this file (gitignored). The preflight fails if any placeholder is left, and
# records the as-run pins.local.env hash.
PIN_CLAUDE_VERSION='2.1.310 (Claude Code)'   # the H1 pin (#808)
PIN_MODEL='claude-opus-5-5'                  # passed as --model; the init event must report it
PIN_MNEME_BASE='59309fe7000cd1173f614aca1ff4f0e1b71edb75'  # P2-first squash (#815); mneme/ must equal this tree
PIN_MNEME_VERSION='0.11.0'
# Mneme source the hook imports: a checkout whose mneme/ is identical to PIN_MNEME_BASE.
MNEME_SRC_W='<MNEME_SRC windows path>'
MNEME_SRC_U='<MNEME_SRC posix path>'
# Python used by the hook command (no spaces in path).
PY='<PYTHON: absolute path to python.exe, no spaces>'
# Disposable probe repos live OUTSIDE any git checkout and any .mneme ancestor.
LIVE='/c/dev/t08-p2first-live'   # fixed; must match ROOT in safe_rmtree.py (no override)
# Settings sources: `project` only, the H1 run condition (charter §5.2.4
# item 2). The C2 channel is the committed project settings, so it is enough.
SOURCES='project'

# pins.local.env may set only MNEME_SRC_W, MNEME_SRC_U and PY. Every pinned
# value is snapshotted here and compared after it is sourced; any change
# aborts (the H1 guard from the #794 review).
_PIN_VARS='PIN_CLAUDE_VERSION PIN_MODEL PIN_MNEME_BASE PIN_MNEME_VERSION LIVE SOURCES'
_pin_snapshot() { local v; for v in $_PIN_VARS; do printf '%s=%s\n' "$v" "${!v-<unset>}"; done; }
_PIN_BEFORE=$(_pin_snapshot)
_PINS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$_PINS_DIR/pins.local.env" ] && . "$_PINS_DIR/pins.local.env"
if [ "$(_pin_snapshot)" != "$_PIN_BEFORE" ]; then
  _pin_changed=''
  for _v in $_PIN_VARS; do
    printf '%s\n' "$_PIN_BEFORE" | grep -qxF -- "$_v=${!_v-<unset>}" || _pin_changed="$_pin_changed $_v"
  done
  echo "ABORT: pins.local.env changed pinned value(s):$_pin_changed (it may set only MNEME_SRC_W, MNEME_SRC_U, PY)"
  exit 1
fi
