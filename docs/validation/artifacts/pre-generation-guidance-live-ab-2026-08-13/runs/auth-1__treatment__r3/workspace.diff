 from __future__ import annotations
 
+import hashlib
+import hmac
+import secrets
+
+SESSION_COOKIE_NAME = "session_id"
+SESSION_TTL_SECONDS = 60 * 60 * 24 * 14  # 14 days
+
+
+def _sign(session_id: str, secret: str) -> str:
+    return hmac.new(secret.encode(), session_id.encode(), hashlib.sha256).hexdigest()
+
 
 def create_browser_auth_state(user_id: str, secret: str) -> dict[str, object]:
-    raise NotImplementedError
+    session_id = secrets.token_urlsafe(32)
+    cookie_value = f"{session_id}.{_sign(session_id, secret)}"
+
+    return {
+        "session_id": session_id,
+        "user_id": user_id,
+        "cookie": {
+            "name": SESSION_COOKIE_NAME,
+            "value": cookie_value,
+            "http_only": True,
+            "secure": True,
+            "same_site": "Lax",
+            "path": "/",
+            "max_age": SESSION_TTL_SECONDS,
+        },
+    }
+
+
+def verify_browser_auth_state(cookie_value: str, secret: str) -> str | None:
+    session_id, _, signature = cookie_value.partition(".")
+    if not signature or not hmac.compare_digest(signature, _sign(session_id, secret)):
+        return None
+    return session_id
