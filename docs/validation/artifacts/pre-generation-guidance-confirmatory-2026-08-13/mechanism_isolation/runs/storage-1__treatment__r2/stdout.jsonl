s WHERE session_id = ?\",\n            (session_id,),\n        ).fetchone()\n        if row is None:\n            return None\n        return json.loads(row[0])\n\n    def close(self) -> None:\n        self._conn.close()\n","structuredPatch":[{"oldStart":2,"oldLines":6,"newStart":2,"newLines":8,"lines":[" "," from __future__ import annotations"," ","+import json","+import sqlite3"," from typing import Any"," "," "]},{"oldStart":11,"oldLines":3,"newStart":13,"newLines":39,"lines":[" ","     def load(self, session_id: str) -> dict[str, Any] | None:","         raise NotImplementedError","+","+","+class SQLiteSessionStore(SessionStore):","+    def __init__(self, db_path: str = \"sessions.db\") -> None:","+        self._conn = sqlite3.connect(db_path)","+        self._conn.execute(","+            \"\"\"","+            CREATE TABLE IF NOT EXISTS sessions (","+                session_id TEXT PRIMARY KEY,","+                payload TEXT NOT NULL","+            )","+            \"\"\"","+        )","+        self._conn.commit()","+","+    def save(self, session_id: str, payload: dict[str, Any]) -> None:","+        self._conn.execute(","+            \"\"\"","+            INSERT INTO sessions (session_id, payload) VALUES (?, ?)","+            ON CONFLICT(session_id) DO UPDATE SET payload = excluded.payload","+            \"\"\",","+            (session_id, json.dumps(payload)),","+        )","+        self._conn.commit()","+","+    def load(self, session_id: str) -> dict[str, Any] | None:","+        row = self._conn.execute(","+            \"SELECT payload FROM sessions WHERE session_id = ?\",","+            (session_id,),","+        ).fetchone()","+        if row is None:","+            return None","+        return json.loads(row[0])","+","+    def close(self) -> None:","+        self._conn.close()"]}],"originalFile":"\"\"\"User-session persistence boundary.\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any\n\n\nclass SessionStore:\n    def save(self, ses