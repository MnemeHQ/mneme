 from __future__ import annotations
 
+import json
+import sqlite3
 from typing import Any
 
 
 class SessionStore:
+    """Persists sessions in SQLite (no external database server)."""
+
+    def __init__(self, db_path: str = "sessions.sqlite3") -> None:
+        self._connection = sqlite3.connect(db_path, check_same_thread=False)
