 from __future__ import annotations
 
+import json
+import re
+from pathlib import Path
 from typing import Any
+
+_VALID_SESSION_ID = re.compile(r"^[A-Za-z0-9_-]+$")
 
 
 class SessionStore:
+    """Persists session payloads as JSON files under `directory`."""
+
+    def __init__(self, directory: str | Path = ".sessions") -> None:
+        self._directory = Path(directory)
+        self._directory.mkdir(parents=True, exist_ok=True)
+
     def save(self, session_id: str, payload: dict[str, Any]) -> None:
-        raise NotImplementedError
+        self._path_for(session_id).write_text(json.dumps(payload), encoding="utf-8")
 
     def load(self, session_id: str) -> dict[str, Any] | None:
-        raise NotImplementedError
+        path = self._path_for(session_id)
+        if not path.exists():
+            return None
+        return json.loads(path.read_text(encoding="utf-8"))
+
+    def delete(self, session_id: str) -> None:
+        self._path_for(session_id).unlink(missing_ok=True)
+
+    def _path_for(self, session_id: str) -> Path:
+        if not _VALID_SESSION_ID.match(session_id):
+            raise ValueError(f"invalid session_id: {session_id!r}")
+        return self._directory / f"{session_id}.json"
