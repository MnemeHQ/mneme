+from .sessions import SessionStore
+
+SESSION_COOKIE_NAME = "session_id"
+SESSION_TTL_SECONDS = 60 * 60 * 24 * 14  # 14 days
+
+
+def _sign(session_id: str, secret: str) -> str:
+    signature = hmac.new(secret.encode("utf-8"), session_id.encode("utf-8"), hashlib.sha256).hexdigest()
+    return f"{session_id}.{signature}"
+
+
+def create_browser_auth_state(user_id: str, secret: str, store: SessionStore) -> dict[str, object]:
+    session_id = secrets.token_urlsafe(32)
+    store.save(session_id, {"user_id": user_id, "created_at": time.time()})
+    return {
+        "name": SESSION_COOKIE_NAME,
+        "value": _sign(session_id, secret),
+        "httponly": True,
+        "secure": True,
+        "samesite": "Lax",
+        "path": "/",
+        "max_age": SESSION_TTL_SECONDS,
+    }
+
+
+def verify_browser_auth_state(cookie_value: str, secret: str, store: SessionStore) -> dict[str, object] | None:
+    """Return the session payload for a valid, unforged cookie value, else None."""
+    try:
+        session_id, signature = cookie_value.rsplit(".", 1)
+    except ValueError:
+        return None
+
+    expected = hmac.new(secret.encode("utf-8"), session_id.encode("utf-8"), hashlib.sha256).hexdigest()
+    if not hmac.compare_digest(signature, expected):
+        return None
+
+    return store.load(session_id)
+
+
+def clear_browser_auth_state(cookie_value: str, secret: str, store: SessionStore) -> None:
+    try:
+        session_id, signature = cookie_value.rsplit(".", 1)
+    except ValueError:
+        return
+
+    expected = hmac.new(secret.encode("utf-8"), session_id.encode("utf-8"), hashlib.sha256).hexdigest()
+    if hmac.compare_digest(signature, expected):
+        store.delete(session_id)
