) -> dict[str, Any] | None:\n        path = self._path_for(session_id)\n        if not path.exists():\n            return None\n        return json.loads(path.read_text(encoding=\"utf-8\"))"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":901,"cache_read_input_tokens":10878,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":901},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a2b1f7a1-3081-4716-9adb-0bdd3880f7e8","uuid":"44aed293-794c-4f7f-846f-8ba93cd214b2","request_id":"req_011Ce1QGqzntBfDNSGoUEANn"}
