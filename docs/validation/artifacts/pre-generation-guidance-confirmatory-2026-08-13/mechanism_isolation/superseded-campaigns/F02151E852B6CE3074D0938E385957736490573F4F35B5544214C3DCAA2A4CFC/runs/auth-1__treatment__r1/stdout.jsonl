\": COOKIE_NAME,\n        \"value\": f\"{encoded_payload}.{signature}\",\n        \"http_only\": True,\n        \"secure\": True,\n        \"same_site\": \"Lax\",\n        \"max_age\": MAX_AGE_SECONDS,\n        \"path\": \"/\",\n    }\n\n\ndef verify_browser_auth_state(cookie_value: str, secret: str) -> dict[str, object] | None:\n    \"\"\"Validate a cookie value produced by create_browser_auth_state.\n\n    Returns the decoded payload (user_id, issued_at) on success, or None if\n    the signature is invalid, missing, or malformed.\n    \"\"\"\n    try:\n        encoded_payload, signature = cookie_value.split(\".\", 1)\n    except ValueError:\n        return None\n\n    expected_signature = _sign(encoded_payload, secret)\n    if not hmac.compare_digest(signature, expected_signature):\n        return None\n\n    padding = \"=\" * (-len(encoded_payload) % 4)\n    try:\n        payload = json.loads(base64.urlsafe_b64decode(encoded_payload + padding))\n    except (ValueError, json.JSONDecodeError):\n        return None\n\n    return payload","originalFile":"\"\"\"Browser authentication-state boundary.\"\"\"\n\nfrom __future__ import annotations\n\n\ndef create_browser_auth_state(user_id: str, secret: str) -> dict[str, object]:\n    raise NotImplementedError\n","structuredPatch":[{"oldStart":2,"oldLines":6,"newStart":2,"newLines":63,"lines":[" "," from __future__ import annotations"," ","+import base64","+import hashlib","+import hmac","+import json","+import time"," ","+COOKIE_NAME = \"session\"","+MAX_AGE_SECONDS = 60 * 60 * 24 * 14  # 14 days","+","+","+def _sign(encoded_payload: str, secret: str) -> str:","+    digest = hmac.new(secret.encode(\"utf-8\"), encoded_payload.encode(\"ascii\"), hashlib.sha256).digest()","+    return base64.urlsafe_b64encode(digest).decode(\"ascii\").rstrip(\"=\")","+","+"," def create_browser_auth_state(user_id: str, secret: str) -> dict[str, object]:","-    raise NotImplementedError","+    \"\"\"Build a signed, HTTP-only cookie descriptor