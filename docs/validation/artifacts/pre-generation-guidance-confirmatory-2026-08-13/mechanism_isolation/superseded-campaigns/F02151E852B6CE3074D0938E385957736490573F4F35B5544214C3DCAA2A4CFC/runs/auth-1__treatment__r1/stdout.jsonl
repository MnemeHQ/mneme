ecret: str) -> dict[str, object] | None:\n    \"\"\"Validate a cookie value produced by create_browser_auth_state.\n\n    Returns the decoded payload (user_id, issued_at) on success, or None if\n    the signature is invalid, missing, or malformed.\n    \"\"\"\n    try:\n        encoded_payload, signature = cookie_value.split(\".\", 1)\n    except ValueError:\n        return None\n\n    expected_signature = _sign(encoded_payload, secret)\n    if not hmac.compare_digest(signature, expected_signature):\n        return None\n\n    padding = \"=\" * (-len(encoded_payload) % 4)\n    try:\n        payload = json.loads(base64.urlsafe_b64decode(encoded_payload + padding))\n    except (ValueError, json.JSONDecodeError):\n        return None\n\n    return payload"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":901,"cache_read_input_tokens":15230,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":901},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e717ef36-4e09-4c2e-ac6f-7075bb801ea1","uuid":"a5d53ce9-861d-4f13-bedc-b78b00204554","request_id":"req_011Ce1PkLUBzgmEC7WmVWhEH"}
