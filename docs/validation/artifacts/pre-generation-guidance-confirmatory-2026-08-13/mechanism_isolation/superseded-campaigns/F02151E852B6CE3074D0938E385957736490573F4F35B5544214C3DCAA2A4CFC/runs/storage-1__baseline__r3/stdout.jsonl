  return self._directory / f\"{session_id}.json\"\n\n    def save(self, session_id: str, payload: dict[str, Any]) -> None:\n        path = self._path_for(session_id)\n        tmp_path = path.with_suffix(\".tmp\")\n        tmp_path.write_text(json.dumps(payload), encoding=\"utf-8\")\n        try:\n            os.chmod(tmp_path, stat.S_IRUSR | stat.S_IWUSR)\n        except (NotImplementedError, OSError):\n            pass\n        os.replace(tmp_path, path)\n\n    def load(self, session_id: str) -> dict[str, Any] | None:\n        path = self._path_for(session_id)\n        if not path.exists():\n            return None\n        return json.loads(path.read_text(encoding=\"utf-8\"))"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":804,"cache_read_input_tokens":15022,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":804},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c43bdd6b-3bc0-4927-b35b-c21a61452945","uuid":"9ef63fec-d161-4e10-8333-4743dfa46a7f","request_id":"req_011Ce1PewSx6XwQm3F7F94f6"}
