{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.MnemeHQ/mneme",
  "title": "Mneme Decision MCP",
  "description": "Local MCP server for architectural decisions, traceability, and non-authoritative proposals.",
  "websiteUrl": "https://mnemehq.com/integrations/mcp/",
  "repository": {
    "url": "https://github.com/MnemeHQ/mneme",
    "source": "github"
  },
  "version": "0.9.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "mneme-hq",
      "version": "0.9.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "mneme-hq[mcp]==0.9.0"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mneme"
        },
        {
          "type": "positional",
          "value": "decision-mcp"
        }
      ]
    }
  ]
}
